{
  "site": {
    "id": "${FLEEK_SITE_ID}",
    "name": "eagle-x-dashboard",
    "framework": "static",
    "publishDirectory": "dist",
    "buildCommand": "python3 scripts/build_static_site.py",
    "environment": {
      "API_ORIGIN": "${EAGLE_API_ORIGIN}"
    }
  },
  "deploy": {
    "protocol": "ipfs",
    "autoPublish": false,
    "gateway": "https://ipfs.io/ipfs/{CID}"
  }
}

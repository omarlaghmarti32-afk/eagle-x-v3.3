# Copy to .env and fill in values
# cp .env.example .env

# REQUIRED in production — long random string
EAGLE_API_TOKEN=change-me-to-a-long-random-secret

# Local default domain uses internal TLS
EAGLE_DOMAIN=localhost
CADDY_EMAIL=admin@localhost

# Production Let's Encrypt example:
# EAGLE_DOMAIN=eagle.example.com
# CADDY_EMAIL=ops@example.com
# CADDYFILE=./Caddyfile.production

# Build liboqs into the image (1=yes, 0=skip for faster builds)
ENABLE_PQC=1

# Optional packet capture (needs privileges)
EAGLE_PCAP=0

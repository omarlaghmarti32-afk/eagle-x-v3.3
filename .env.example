# Copy to .env and fill in values
# cp .env.example .env

# REQUIRED in production: long random secret (>=16 chars)
EAGLE_API_TOKEN=change-me-to-a-long-random-secret

# Enforce strong token at startup (set 0 only for local tests)
EAGLE_REQUIRE_STRONG_TOKEN=1

# CORS: * or comma-separated origins
EAGLE_CORS_ORIGINS=*

# Rate limit (requests per minute per IP on mutating routes)
EAGLE_RATE_LIMIT_PER_MIN=120

# Protect read APIs (/status /stats /threats /config) with Bearer token
EAGLE_PROTECT_READ_APIS=0

EAGLE_DOMAIN=localhost
CADDY_EMAIL=admin@localhost

# Production Let's Encrypt:
# EAGLE_DOMAIN=eagle.example.com
# CADDY_EMAIL=ops@example.com
# CADDYFILE=./Caddyfile.production

ENABLE_PQC=1
EAGLE_PCAP=0

# Health monitoring
EAGLE_HEALTH_INTERNAL=1
EAGLE_HEALTH_INTERNAL_INTERVAL=60
EAGLE_HEALTH_INTERVAL=30
EAGLE_HEALTH_FAIL_THRESHOLD=3
# Optional alert webhook (Slack/Discord/etc.)
# EAGLE_HEALTH_WEBHOOK=https://hooks.example.com/...
